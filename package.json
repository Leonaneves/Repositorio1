{
  "name": "ficha-dnd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ficha de personagem D&D 2024 para web — modelo de dados, dados estáticos, motor de regras, interface e sistema de insights da comunidade.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "references": "tsx scripts/reference-import.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.2"
  }
}
